{
	"name": "velo-mail",
	"productName": "Velo Mail",
	"description": "Ein schlanker Desktop-Mailclient",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"main": "out/main.js",
	"author": "Sniphs98",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:web": "vite dev",
		"build": "vite build && node scripts/build-electron.mjs",
		"package": "npm run build && electron-builder --publish never",
		"start": "electron .",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p electron",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest --project client --project server",
		"test:integration": "vitest --run --project integration",
		"test": "npm run test:unit -- --run && npm run test:integration && npm run test:e2e",
		"test:e2e": "npm run build && playwright test",
		"db:generate": "drizzle-kit generate"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.61.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@tiptap/core": "^3.32.0",
		"@tiptap/extensions": "^3.32.0",
		"@tiptap/pm": "^3.32.0",
		"@tiptap/starter-kit": "^3.32.0",
		"@types/node": "^22",
		"@types/nodemailer": "^8.0.2",
		"@vitest/browser-playwright": "^4.1.8",
		"bits-ui": "^2.20.2",
		"cn": "^0.5.0",
		"dompurify": "^3.4.17",
		"drizzle-kit": "1.0.0-rc.5",
		"electron": "^45.0.0",
		"electron-builder": "^26.18.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"drizzle-orm": "1.0.0-rc.5",
		"electron-updater": "^6.8.9",
		"fast-xml-parser": "^5.11.2",
		"imapflow": "^2.9.1",
		"nodemailer": "^10.2.1",
		"postal-mime": "^4.1.4",
		"unpdf": "^1.9.1",
		"zod": "^4.6.7"
	}
}
